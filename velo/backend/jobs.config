{
  "jobs": [
    {
      "functionLocation": "/reporting.web.js",
      "functionName": "advanceStatuses",
      "description": "Advance booking statuses (Confirmed/In-House/Checked-Out)",
      "executionConfig": {
        "cronExpression": "0 5 * * *"
      }
    },
    {
      "functionLocation": "/calendarReconciler.web.js",
      "functionName": "reconcileRoomCalendar",
      "description": "Retry room calendar events and reconcile owner blocks",
      "executionConfig": {
        "cronExpression": "0 * * * *"
      }
    }
  ]
}
